{
  "name": "voodoo-hack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "verifier": "npm run build && node tools/capture.mjs",
    "captures": "node tools/capture.mjs --parcours --demo",
    "video": "node tools/capture.mjs --parcours --demo --video",
    "planche": "node tools/planche.mjs",
    "anim": "node tools/anim/anim-eval.mjs",
    "dashboard": "node tools/dashboard/server.mjs",
    "perf": "node tools/perf/bench.mjs",
    "demo": "vite build && vite preview --port 4173 --strictPort",
    "demo:chrome": "node tools/perf/chrome-nvidia.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@google/genai": "^2.24.0",
    "three": "^0.186.1"
  }
}