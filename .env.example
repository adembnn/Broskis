# Clés API du jeu. Copie ce fichier en `.env` et remplis les valeurs (jamais commité, jamais lu par Claude).
# Important : PAS de préfixe VITE_ sur ces noms. Une variable VITE_xxx est incluse en clair dans le
# code envoyé au navigateur (visible par n'importe qui dans les outils de dev) : ces clés doivent
# rester côté serveur/outils, jamais dans le bundle du jeu.
GEMINI_API_KEY=
GRADIUM_API_KEY=
TRIPO_API_KEY=
